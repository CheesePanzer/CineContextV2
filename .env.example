# The launcher provisions an isolated development database if DATABASE_URL is omitted.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cinecontext
# Select cinecontext.mock.main (default) or cinecontext.main.
CINECONTEXT_APP=mock
# CINECONTEXT_APP=production
# TACC profile: CINECONTEXT_APP=production and APP_ENVIRONMENT=tacc
# APP__MODEL__TACC_JOB_ID=
# APP__MODEL__TCLOUD_BIN=tcloud
# APP__TOOLS__WIKIPEDIA_ENABLED=true
# CINECONTEXT_PORT=8766
# CINECONTEXT_DB_PORT=55439
# Application logs. Technical run.error detail is useful for debugging but may reveal sanitized service messages.
# APP__LOGGING__LEVEL=INFO
# APP__LOGGING__CONSOLE_ENABLED=true
# APP__LOGGING__FILE_ENABLED=true
# APP__LOGGING__PATH=.runtime/logs/cinecontext.log
# APP__LOGGING__MAX_BYTES=10000000
# APP__LOGGING__BACKUP_COUNT=5
# APP__LOGGING__INCLUDE_TECHNICAL_FAILURE_DETAIL=true
# Raw model responses may contain user/source content. Enable only for local diagnosis.
# APP__LOGGING__CAPTURE_MODEL_RESPONSES=false
# APP__LOGGING__MODEL_RESPONSE_PATH=.runtime/logs/model-responses
# Production uses Alcedo Options[ModelOptions]. Double underscores address nested keys.
# APP__MODEL__API_STYLE=chat_completions
# APP__MODEL__BASE_URL=https://api.deepseek.com
# APP__MODEL__API_KEY=
# APP__MODEL__MODEL_ID=deepseek-flash
# APP__MODEL__TIMEOUT_SECONDS=180
# APP__MODEL__MAX_RETRIES=1
# APP__MODEL__MAX_TOKENS=6000
# APP__MODEL__TEMPERATURE=0.2
# APP__MODEL__JSON_RESPONSE=true
# APP__MODEL__THINKING=disabled
# APP__MODEL__PROMPT_CACHE=false
# APP__MODEL__STRUCTURED_OUTPUT_RETRIES=1
# External tools use Alcedo Options[ToolsOptions]. URLs and limits have defaults in appsettings.yaml.
# APP__TOOLS__TIMEOUT_SECONDS=15
# APP__TOOLS__TMDB__ACCESS_TOKEN=
# APP__TOOLS__BRAVE__API_KEY=
# Free web search is enabled when Brave has no API key. Each value below is optional.
# APP__TOOLS__DUCKDUCKGO__ENABLED=true
# APP__TOOLS__DUCKDUCKGO__ENDPOINT=https://html.duckduckgo.com/html/
# APP__TOOLS__DUCKDUCKGO__QUERY_LENGTH=600
# APP__TOOLS__DUCKDUCKGO__RESULT_LIMIT=4
# APP__TOOLS__CRAWLER__ENABLED=true
# APP__TOOLS__CRAWLER__MAX_PAGES=4
# APP__TOOLS__CRAWLER__RESPONSE_BYTE_LIMIT=1000000
# APP__TOOLS__CRAWLER__EXCERPT_LENGTH=1400
# APP__TOOLS__CRAWLER__USER_AGENT=CineContext/0.1 (+https://github.com/)
# APP__TOOLS__CRAWLER__MAX_REDIRECTS=3
# APP__TOOLS__OMDB__API_KEY=
